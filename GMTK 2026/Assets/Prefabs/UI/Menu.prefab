      m_Calls: []
  m_text: '<style=h1>The Control Room</style>

    Click on penguins to get their
    <color=#53b2a6>recommendations</color> on what rocket parts to use.


    The
    penguns will occasionally <color=#53b2a6>get distracted</color> and stop working
    on the ship!  <color=#53b2a6>Rapidly click on the popups</color> to solve their
    problems. '
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2c8532119180c7c478e771fa404e6373, type: 2}
